# NeuroSim Backend Environment Variables

# CORS Settings
CORS_ORIGINS=["http://localhost:3000"]

# TRIBE v2 Settings (optional - requires GPU for real mode)
TRIBE_USE_REAL=false
TRIBE_MODEL_NAME=facebook/tribev2
TRIBE_CACHE_FOLDER=./cache/tribev2
HF_TOKEN=your_huggingface_token

# MiroFish Settings (optional - self-hosted on port 5001)
MIROFISH_USE_REAL=false
MIROFISH_API_URL=http://localhost:5001
MIROFISH_LLM_API_KEY=your_llm_api_key
MIROFISH_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MIROFISH_LLM_MODEL=qwen-plus
MIROFISH_ZEP_API_KEY=your_zep_api_key

# Stage-Gate Threshold
STAGEGATE_THRESHOLD=0.4

# Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE=2147483648

# Supabase (optional — falls back to in-memory if not set)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Premium / Pro Tier (deferred)
PREMIUM_ENABLED=false
PREMIUM_PRICE_MONTHLY=29
PREMIUM_PRICE_YEARLY=290
PREMIUM_MAX_ANALYSES_FREE=10
GPU_PROVIDER=modal

# Stripe (deferred — set when Pro launches)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=
